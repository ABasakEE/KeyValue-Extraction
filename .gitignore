# datasets are large and redistributable only under their own licenses — never commit.
# Leading slash anchors this to the repo root: a bare "data/" would also swallow
# src/data/, which is source code.
/data/
demo_examples/
*.pdf
*.png
*.jpg
*.tif
!slides/figures/*.png
!slides/figures/*.pdf

# model artifacts and archives
*.ckpt
*.safetensors
*.bin
*.pt
*.zip
*.tar.gz
checkpoints/
runs/
wandb/
kaggle_output/
augraphy_cache/

# results: commit the metrics JSON and plots, not the raw prediction dumps
results/**/predictions/
results/**/*.npz

# python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/
scratch/

# latex build products (Overleaf rebuilds these)
slides/*.aux
slides/*.bbl
slides/*.bcf
slides/*.blg
slides/*.log
slides/*.nav
slides/*.out
slides/*.run.xml
slides/*.snm
slides/*.toc
slides/*.synctex.gz
slides/main.pdf
